# Скопируйте этот файл в .env (scripts/setup.bat сделает это сам) и впишите значения.
# Без пробелов вокруг "=" и без кавычек. Строки с # игнорируются.

# --- нужно для Telegram-бота ---
BOT_TOKEN=
# Ваш Telegram ID (узнать: @userinfobot). Несколько через запятую: 123,456
ALLOWED_IDS=

# --- нужно всегда ---
# Сервисный ключ приложения VK
VK_TOKEN=

# --- необязательно: поиск в Telegram ---
TG_API_ID=
TG_API_HASH=

# --- нужно для сайта ---
WEB_USER=admin
WEB_PASS=

# --- необязательно: проверка email ---
# Платный ключ Have I Been Pwned (haveibeenpwned.com/API/Key). Без него проверка утечек пропускается.
HIBP_API_KEY=

# --- необязательно: доп. сканеры ников (после проверки командой check_tools.bat) ---
# Варианты через запятую: naminter,aliens,argis
EXTRA_SCANNERS=

# --- необязательно: где лежит интерфейс (по умолчанию папка ui рядом с web.py) ---
UI_DIR=
